# Админ нэвтрэх нууц үгийг өөрөө солино уу.
ADMIN_PASSWORD=replace-with-a-long-private-password

# Нэмэлт session гарын үсгийн нууц түлхүүр (ADMIN_PASSWORD-оос өөр урт утга байвал сайн).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# SMTP имэйл илгээх тохиргоо (SSL/TLS порт 465 ашиглана).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-sender@example.com
SMTP_PASS=your-mail-app-password
SMTP_FROM=your-sender@example.com

# Vercel дээр: Storage → Upstash Redis холбоход доорх хоёр хувьсагч автоматаар нэмэгдэнэ.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel дээр: Firebase Firestore хадгалалт.
# Firebase Console → Project settings → Service accounts → "Generate new private key" JSON файлыг base64 болгож хуулна:
#   Mac/Linux: base64 -w0 service-account.json     Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
